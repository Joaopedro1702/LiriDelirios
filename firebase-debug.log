[debug] [2026-05-21T21:37:07.091Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/liri-delirios/rulesets {"name":"projects/liri-delirios/rulesets/f813bed6-4d18-402f-b22f-9a813aa69661","source":{"files":[{"content":"rules_version = '2';\n\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    function signedIn() {\n      return request.auth != null;\n    }\n\n    function isAdmin() {\n      return signedIn() && request.auth.token.email == 'contato.liridelirios@gmail.com';\n    }\n\n    function isOwner(userId) {\n      return signedIn() && request.auth.uid == userId;\n    }\n\n    match /produtos/{produtoId} {\n      allow read: if true;\n      allow create, update, delete: if isAdmin();\n    }\n\n    match /cupons/{cupomId} {\n      allow read: if true;\n      allow create, update, delete: if isAdmin();\n    }\n\n    match /pedidos/{pedidoId} {\n      allow create: if signedIn()\n        && request.resource.data.usuarioId == request.auth.uid\n        && request.resource.data.status == 'pendente';\n\n      allow read: if isAdmin() || isOwner(resource.data.usuarioId);\n      allow update, delete: if isAdmin();\n    }\n\n    match /clientes/{clienteId} {\n      allow create, read, update, delete: if isOwner(clienteId);\n    }\n\n    match /usuarios/{usuarioId} {\n      allow create, read, update, delete: if isOwner(usuarioId);\n    }\n\n    match /enderecos/{enderecoId} {\n      allow create: if signedIn()\n        && request.resource.data.usuarioId == request.auth.uid;\n      allow read, update, delete: if isAdmin() || isOwner(resource.data.usuarioId);\n    }\n\n    match /{document=**} {\n      allow read, write: if false;\n    }\n  }\n}\n","name":"firestore.rules"}]},"createTime":"2026-05-21T21:37:06.961471Z","metadata":{"services":["cloud.firestore"]}}
