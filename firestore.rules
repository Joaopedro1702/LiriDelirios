rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.email == 'contato.liridelirios@gmail.com';
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    match /produtos/{produtoId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /cupons/{cupomId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /pedidos/{pedidoId} {
      allow create: if signedIn()
        && request.resource.data.usuarioId == request.auth.uid
        && request.resource.data.status == 'pendente';

      allow read: if isAdmin() || isOwner(resource.data.usuarioId);
      allow update, delete: if isAdmin();
    }

    match /clientes/{clienteId} {
      allow create, read, update, delete: if isOwner(clienteId);
    }

    match /usuarios/{usuarioId} {
      allow create, read, update, delete: if isOwner(usuarioId);
    }

    match /enderecos/{enderecoId} {
      allow create: if signedIn()
        && request.resource.data.usuarioId == request.auth.uid;
      allow read, update, delete: if isAdmin() || isOwner(resource.data.usuarioId);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
